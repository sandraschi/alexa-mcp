# alexa-mcp configuration
# Copy this file to .env and fill in your values

# TTS: Edge-TTS voice (default: en-US-AriaNeural)
# ALEXA_TTS_VOICE=

# STT: Audio device index (default: system default)
# ALEXA_AUDIO_DEVICE=

# FastAPI secret key for auth (optional)
# ALEXA_API_KEY=

# Port for HTTP mode (default: 10801)
# ALEXA_MCP_PORT=10801

# TTS shopping guard (default: 1=on)
# ALEXA_SHOPPING_GUARD=1
